# The gateway: the platform's one address (PLATFORM_URL), names under
# STORSCALE_DOMAIN, listening on GATEWAY_PORT over plain HTTP. In Compose
# people reach it directly; on Kubernetes it may sit behind an ingress that
# ends TLS, which GATEWAY_TRUSTED_PROXIES names, so the tools see the scheme
# people used (X-Forwarded-Proto).
#
# The tools the platform shows in its frames are on paths of that address:
# one origin, so every browser treats them, and their cookies, as the
# platform's own. (Safari blocks the cookies of frames from any other origin,
# subdomains included, which would stop each tool's sign-in.) Each tool is
# configured to run under its path.
{
	auto_https off
	admin off
	servers {
		trusted_proxies static {$GATEWAY_TRUSTED_PROXIES:127.0.0.1/32}
	}
}

(tool) {
	reverse_proxy {args[0]} {
		header_down -X-Frame-Options
	}
	# Only the platform's pages may frame a tool. (A tool that says so
	# itself, as JupyterHub does, keeps its own policy.)
	header ?Content-Security-Policy "frame-ancestors 'self'"
}

http://{$STORSCALE_DOMAIN}:{$GATEWAY_PORT} {
	redir /sso /sso/
	redir /notebooks /notebooks/
	redir /dashboards /dashboards/
	redir /pipelines /pipelines/
	redir /monitoring /monitoring/
	handle /sso/* {
		reverse_proxy keycloak:8080
	}
	# The MCP server, and its OAuth metadata (which names Keycloak as the
	# authorization server), for agents.
	handle /mcp* {
		reverse_proxy semanticd:8000
	}
	handle /.well-known/oauth-protected-resource* {
		reverse_proxy semanticd:8000
	}
	handle /notebooks/* {
		import tool jupyterhub:8000
	}
	handle /dashboards/* {
		import tool superset:8088
	}
	handle /pipelines/* {
		import tool airflow:8090
	}
	handle /monitoring/* {
		import tool grafana:3000
	}
	handle {
		reverse_proxy platformd:8080
	}
}

# The tools that open in a tab of their own keep names of their own.
http://catalog.{$STORSCALE_DOMAIN}:{$GATEWAY_PORT} {
	# The platform's way in: starts OpenMetadata's service worker, then signs in.
	handle /_storscale/* {
		root * /srv
		file_server
	}
	handle {
		reverse_proxy openmetadata:8585
	}
}

http://access.{$STORSCALE_DOMAIN}:{$GATEWAY_PORT} {
	reverse_proxy ranger-admin:6080
}

http://s3.{$STORSCALE_DOMAIN}:{$GATEWAY_PORT} {
	reverse_proxy buckets:9000
}

# Any other name: the health check, and nothing else.
http://:{$GATEWAY_PORT} {
	respond /healthz "ok" 200
	respond "Not found: use {$PLATFORM_URL}" 404
}
