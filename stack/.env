# Settings for StorScale Platform on one machine. Every value here is a local
# test value: change them all before running this anywhere but your own machine.

# The platform's domain and port. Browsers resolve *.localhost to this machine.
STORSCALE_DOMAIN=storscale.localhost
STORSCALE_PORT=8800

# The platform's own image (platformd and its web app), and its Keycloak
# client secret. `storscale up --dir stack` in a checkout builds the image instead.
PLATFORMD_IMAGE=ghcr.io/storscale/platformd:0.15.0
PLATFORM_OAUTH_SECRET=platform-oauth-secret-change-me
# platformd's Buckets account, for the project store (the storscale-platform
# bucket), and the platform operator's Keycloak client secret.
PLATFORM_STORE_ACCESS_KEY=platform-svc
PLATFORM_STORE_SECRET_KEY=platform-svc-secret-1
OPERATOR_CLIENT_SECRET=platform-operator-secret-change-me

# The Buckets server image. Releases are on ghcr.io/storscale.
BUCKETS_IMAGE=ghcr.io/storscale/bucketsd:1.19.0
BUCKETS_ROOT_USER=admin
BUCKETS_ROOT_PASSWORD=storscale-admin-1

# Buckets service accounts for the engines. Only these can read the warehouse.
TRINO_S3_ACCESS_KEY=trino-svc
TRINO_S3_SECRET_KEY=trino-svc-secret-1
NESSIE_S3_ACCESS_KEY=nessie-svc
NESSIE_S3_SECRET_KEY=nessie-svc-secret-1
# The backups' account (backups are Kubernetes installs'; the bucket's made here too).
BACKUP_S3_ACCESS_KEY=backup-svc
BACKUP_S3_SECRET_KEY=backup-svc-secret-1

# Keycloak's admin, its database, and the password of the example people
# alice (analysts), bob (engineers) and carol (in neither group).
KEYCLOAK_ADMIN_PASSWORD=keycloak-admin-1
KEYCLOAK_DB_PASSWORD=keycloak-db-1
NESSIE_DB_PASSWORD=nessie-db-1
LAKEHOUSE_USER_PASSWORD=lakehouse-user-1

# Ranger: the admin password (user "admin"), and its database's. Ranger wants
# 8+ characters with letters and digits. Trino's Ranger plugin signs in to
# Ranger as "trino-plugin" to fetch policies.
RANGER_PASSWORD=rangerR0cks1
RANGER_PLUGIN_PASSWORD=trinoPlugin1

TRINO_SHARED_SECRET=storscale-trino-internal-secret-change-me
# Trino's limits' database (its resource groups, which the platform operator keeps).
TRINO_DB_PASSWORD=trino-db-1

# JupyterHub's Keycloak client secret, and the key that encrypts the tokens it
# keeps for each person (32 bytes, hex: openssl rand -hex 32).
JUPYTERHUB_OAUTH_SECRET=jupyterhub-oauth-secret-change-me
JUPYTERHUB_CRYPT_KEY=181567c4fc2ddb0bb9f8f0e79262db0f21bd85748cf3eda52dd0d41e1b7a2a64
# The Docker socket JupyterHub starts notebook containers through. Rootless
# Docker (Lima, for example) has it at /run/user/<uid>/docker.sock.
DOCKER_SOCK=/var/run/docker.sock

# Superset's Keycloak client secret, its session key, its database, and the
# password it signs in to Trino with, as the service user "superset".
SUPERSET_OAUTH_SECRET=superset-oauth-secret-change-me
SUPERSET_SECRET_KEY=superset-session-key-change-me-0123456789abcdef
SUPERSET_DB_PASSWORD=superset-db-1
SUPERSET_TRINO_PASSWORD=superset-trino-1

# Airflow's Keycloak clients: "airflow" for people's sign-in, and
# "airflow-pipelines", the service account the pipelines run as. Then its
# database, the key it encrypts connections with (Fernet), and its signing keys.
AIRFLOW_OAUTH_SECRET=airflow-oauth-secret-change-me
AIRFLOW_PIPELINES_SECRET=airflow-pipelines-secret-change-me
AIRFLOW_DB_PASSWORD=airflow-db-1
AIRFLOW_FERNET_KEY=CSBZLmAwTIsrdgMBhMFFF2fNOAUM-qrBrbPwm5i5BY8=
AIRFLOW_SECRET_KEY=airflow-session-key-change-me-0123456789
AIRFLOW_JWT_SECRET=airflow-jwt-secret-change-me-0123456789
# The platform's own Airflow account (role Op): it shows each project's runs,
# and starts runs for the project's editors.
AIRFLOW_PLATFORM_PASSWORD=storscale-platform-airflow-1

# The catalog (OpenMetadata): its Keycloak client secret, its database, the key
# it encrypts connection secrets with (Fernet), and the password it signs in
# to Trino with, as the service user "openmetadata".
OPENMETADATA_OAUTH_SECRET=openmetadata-oauth-secret-change-me
OPENMETADATA_DB_PASSWORD=openmetadata-db-1
OPENMETADATA_FERNET_KEY=jJ/9sz0g0OHxsfxOoSfdFdmk3ysNmPRnH3TUAbz3IHA=
OPENMETADATA_TRINO_PASSWORD=openmetadata-trino-1

# Table maintenance: the platform's Trino account for it; and Nessie's GC,
# which deletes the tables' history older than NESSIE_GC_KEEP (an ISO 8601
# duration: P7D for a week), daily, or every NESSIE_GC_EVERY seconds. Here
# two minutes' history, every three minutes, so the maintenance suite sees
# history go: on an install for real use, P7D or more, and no NESSIE_GC_EVERY.
MAINTENANCE_TRINO_PASSWORD=maintenance-trino-1
# The projects' sources' copies (change capture, Kubernetes): their Buckets account.
COPY_S3_ACCESS_KEY=copy
COPY_S3_SECRET_KEY=copy-secret-1
# The platform operator's Trino account: it makes the projects' sources' catalogs.
OPERATOR_TRINO_PASSWORD=operator-trino-1
NESSIE_GC_KEEP=PT2M
NESSIE_GC_EVERY=180

# Monitoring: the metrics-only user Prometheus scrapes as, Grafana's admin (for
# when Keycloak is down), and Grafana's Keycloak client secret.
PROMETHEUS_USER=prometheus
PROMETHEUS_SECRET=prometheus-secret-1
GRAFANA_ADMIN_PASSWORD=grafana-admin-1
GRAFANA_OAUTH_SECRET=grafana-oauth-secret-change-me

# The LLM gateway's master key (12.1): the stand-in's, or LiteLLM's, as platformd and the operator hold it.
LLM_MASTER_KEY=sk-storscale-local
MLFLOW_DB_PASSWORD=mlflow-db-1
MLFLOW_S3_ACCESS_KEY=mlflow-svc
MLFLOW_S3_SECRET_KEY=mlflow-svc-secret-1
