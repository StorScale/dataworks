{
  "realm": "lakehouse",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "groups": [
    {
      "name": "analysts"
    },
    {
      "name": "engineers"
    },
    {
      "name": "pipelines"
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Analyst",
      "credentials": [
        {
          "type": "password",
          "value": "${LAKEHOUSE_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "groups": [
        "/analysts"
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "email": "bob@example.com",
      "firstName": "Bob",
      "lastName": "Engineer",
      "credentials": [
        {
          "type": "password",
          "value": "${LAKEHOUSE_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "groups": [
        "/engineers"
      ]
    },
    {
      "username": "carol",
      "enabled": true,
      "emailVerified": true,
      "email": "carol@example.com",
      "firstName": "Carol",
      "lastName": "Contractor",
      "credentials": [
        {
          "type": "password",
          "value": "${LAKEHOUSE_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "groups": []
    },
    {
      "username": "service-account-airflow-pipelines",
      "enabled": true,
      "serviceAccountClientId": "airflow-pipelines",
      "groups": [
        "/pipelines"
      ]
    },
    {
      "username": "service-account-platform-operator",
      "enabled": true,
      "serviceAccountClientId": "platform-operator",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "query-groups",
          "view-clients",
          "query-clients",
          "manage-clients"
        ]
      }
    }
  ],
  "clients": [
    {
      "clientId": "platform",
      "name": "DataWorks",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${PLATFORM_OAUTH_SECRET:platform-oauth-secret-change-me}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${PLATFORM_URL:http://storscale.localhost:8800}/auth/callback"
      ],
      "webOrigins": [
        "${PLATFORM_URL:http://storscale.localhost:8800}"
      ],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience: lakehouse",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.client.audience": "lakehouse"
          }
        }
      ],
      "attributes": {
        "post.logout.redirect.uris": "${PLATFORM_URL:http://storscale.localhost:8800}/*",
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "lakehouse",
      "name": "Lakehouse (Trino and Buckets)",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:*",
        "https://localhost:*"
      ],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "lakehouse",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "jupyterhub",
      "name": "JupyterHub",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${JUPYTERHUB_OAUTH_SECRET:jupyterhub-oauth-secret-change-me}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${PLATFORM_URL:http://storscale.localhost:8800}/notebooks/hub/oauth_callback"
      ],
      "webOrigins": [
        "${PLATFORM_URL:http://storscale.localhost:8800}"
      ],
      "attributes": {
        "post.logout.redirect.uris": "${PLATFORM_URL:http://storscale.localhost:8800}/notebooks/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience: lakehouse",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "lakehouse",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "superset",
      "name": "Apache Superset",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SUPERSET_OAUTH_SECRET:superset-oauth-secret-change-me}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${PLATFORM_URL:http://storscale.localhost:8800}/dashboards/oauth-authorized/keycloak"
      ],
      "webOrigins": [
        "${PLATFORM_URL:http://storscale.localhost:8800}"
      ],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "grafana",
      "name": "Grafana",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${GRAFANA_OAUTH_SECRET:grafana-oauth-secret-change-me}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${PLATFORM_URL:http://storscale.localhost:8800}/monitoring/login/generic_oauth"
      ],
      "webOrigins": [
        "${PLATFORM_URL:http://storscale.localhost:8800}"
      ],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "attributes": {
        "post.logout.redirect.uris": "${PLATFORM_URL:http://storscale.localhost:8800}/monitoring/*"
      }
    },
    {
      "clientId": "airflow",
      "name": "Apache Airflow",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${AIRFLOW_OAUTH_SECRET:airflow-oauth-secret-change-me}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${PLATFORM_URL:http://storscale.localhost:8800}/pipelines/auth/oauth-authorized/keycloak",
        "${PLATFORM_URL:http://storscale.localhost:8800}/airflow/*"
      ],
      "webOrigins": [
        "${PLATFORM_URL:http://storscale.localhost:8800}"
      ],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "airflow-pipelines",
      "name": "Airflow pipelines (service account)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${AIRFLOW_PIPELINES_SECRET:airflow-pipelines-secret-change-me}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience: lakehouse",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "lakehouse",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "platform-operator",
      "name": "DataWorks operator (service account)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OPERATOR_CLIENT_SECRET:platform-operator-secret-change-me}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "openmetadata",
      "name": "OpenMetadata",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OPENMETADATA_OAUTH_SECRET:openmetadata-oauth-secret-change-me}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${CATALOG_PUBLIC_URL:http://catalog.storscale.localhost:8800}/callback",
        "${CATALOG_PUBLIC_URL:http://catalog.storscale.localhost:8800}/silent-callback"
      ],
      "webOrigins": [
        "${CATALOG_PUBLIC_URL:http://catalog.storscale.localhost:8800}"
      ],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "attributes": {
        "post.logout.redirect.uris": "${CATALOG_PUBLIC_URL:http://catalog.storscale.localhost:8800}/*"
      }
    },
    {
      "clientId": "storscale-agent",
      "name": "Agents (MCP clients: Claude, IDEs, scripts)",
      "description": "A public client for agents that use the platform's metrics over MCP, as the person who signs in.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:*",
        "http://127.0.0.1:*",
        "https://claude.ai/api/mcp/auth_callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience: lakehouse (Trino)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.client.audience": "lakehouse"
          }
        },
        {
          "name": "audience: the MCP server",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.custom.audience": "${PLATFORM_URL:http://storscale.localhost:8800}/mcp"
          }
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "storscale-signing",
        "providerId": "rsa",
        "subComponents": {},
        "config": {
          "priority": [
            "200"
          ],
          "enabled": [
            "true"
          ],
          "active": [
            "true"
          ],
          "algorithm": [
            "RS256"
          ],
          "privateKey": [
            "${KC_SIGNING_KEY}"
          ],
          "certificate": [
            "${KC_SIGNING_CERT}"
          ]
        }
      }
    ]
  }
}
