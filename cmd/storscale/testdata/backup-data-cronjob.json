{
 "apiVersion": "batch/v1",
 "kind": "CronJob",
 "metadata": {
  "name": "storscale-backup-data",
  "labels": {
   "app.kubernetes.io/part-of": "storscale-platform",
   "app.kubernetes.io/instance": "x",
   "app.kubernetes.io/managed-by": "Helm",
   "helm.sh/chart": "storscale-platform-0.9.0"
  }
 },
 "spec": {
  "schedule": "30 4 * * *",
  "concurrencyPolicy": "Forbid",
  "successfulJobsHistoryLimit": 2,
  "failedJobsHistoryLimit": 2,
  "jobTemplate": {
   "spec": {
    "backoffLimit": 1,
    "template": {
     "metadata": {
      "labels": {
       "app.kubernetes.io/instance": "x",
       "app.kubernetes.io/name": "storscale-backup-data"
      }
     },
     "spec": {
      "enableServiceLinks": false,
      "automountServiceAccountToken": false,
      "restartPolicy": "Never",
      "initContainers": null,
      "containers": [
       {
        "name": "data",
        "image": "ghcr.io/storscale/platform-tools:0.9.0",
        "securityContext": {
         "allowPrivilegeEscalation": false,
         "runAsNonRoot": true,
         "runAsUser": 65532,
         "runAsGroup": 65532,
         "capabilities": {
          "drop": [
           "ALL"
          ]
         },
         "seccompProfile": {
          "type": "RuntimeDefault"
         }
        },
        "imagePullPolicy": "IfNotPresent",
        "command": [
         "sh",
         "-c"
        ],
        "args": [
         "set -eu\nmc alias set src http://buckets:9000 \"$BUCKETS_ROOT_USER\" \"$BUCKETS_ROOT_PASSWORD\" >/dev/null\nmc alias set dst \"$BACKUP_ENDPOINT\" \"$BACKUP_ACCESS_KEY\" \"$BACKUP_SECRET_KEY\" >/dev/null\nfor b in $(mc ls src | awk '{print $NF}' | tr -d /); do\n  [ \"$b\" = \"$BACKUP_BUCKET\" ] && continue\n  echo \"data: $b\"\n  mc mirror --overwrite --quiet \"src/$b\" \"dst/$BACKUP_BUCKET/data/$b\"\ndone\necho \"data: copied\"\n"
        ],
        "env": [
         {
          "name": "STORSCALE_K8S",
          "value": "true"
         },
         {
          "name": "STORSCALE_VERSION",
          "value": "0.9.0"
         },
         {
          "name": "BACKUP_BUCKET",
          "value": "storscale-backups"
         },
         {
          "name": "BACKUP_KEEP",
          "value": "14"
         },
         {
          "name": "BACKUP_ENDPOINT",
          "value": "http://buckets:9000"
         },
         {
          "name": "BACKUP_REGION",
          "value": "us-east-1"
         },
         {
          "name": "BACKUP_ACCESS_KEY",
          "valueFrom": {
           "secretKeyRef": {
            "name": "storscale-env",
            "key": "BACKUP_S3_ACCESS_KEY"
           }
          }
         },
         {
          "name": "BACKUP_SECRET_KEY",
          "valueFrom": {
           "secretKeyRef": {
            "name": "storscale-env",
            "key": "BACKUP_S3_SECRET_KEY"
           }
          }
         },
         {
          "name": "BUCKETS_ROOT_USER",
          "valueFrom": {
           "secretKeyRef": {
            "name": "storscale-env",
            "key": "BUCKETS_ROOT_USER"
           }
          }
         },
         {
          "name": "BUCKETS_ROOT_PASSWORD",
          "valueFrom": {
           "secretKeyRef": {
            "name": "storscale-env",
            "key": "BUCKETS_ROOT_PASSWORD"
           }
          }
         }
        ],
        "resources": {
         "requests": {
          "cpu": "50m",
          "memory": "128Mi"
         },
         "limits": {
          "memory": "512Mi"
         }
        }
       }
      ]
     }
    }
   }
  }
 }
}